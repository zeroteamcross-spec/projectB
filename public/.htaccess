DirectoryIndex index.html app.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Backend/API routes must keep using the PHP front controller.
RewriteCond %{REQUEST_URI} ^/api(/|$)
RewriteRule ^ index.php [QSA,L]

# Storage uploads are served by public/index.php with path hardening.
RewriteCond %{REQUEST_URI} ^/storage/uploads/
RewriteRule ^ index.php [QSA,L]

# Static files and real directories are served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Hash routing is client-side; unknown non-API paths fall back to the SPA shell.
RewriteRule ^ index.html [L]
</IfModule>
