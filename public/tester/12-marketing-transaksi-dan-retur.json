{
  "nama_fitur": "12 - Transaksi lewat link Marketing sampai ledger accrued, lalu diretur",
  "aplikasi": "projectB",
  "halaman": [
    "#/af/{{marketing_slug}}"
  ],
  "prefix_id": [
    "hr_auth_",
    "pubtrx_",
    "aff_",
    "slrtx_",
    "slrc_",
    "profile_"
  ],
  "versi": "1.0",
  "warisi_variabel": true,
  "berhenti_saat_gagal": true,
  "keterangan": "Alur F3 + D + E3. Buyer membeli car_b lewat link Marketing (#/af/<slug>), dibayar lewat jembatan yang sama seperti skenario 08, lalu diverifikasi ledger komisinya accrued di sisi Marketing. Showroom kemudian meretur transaksi itu, dan diverifikasi mobil kembali published serta ledger jadi voided. Jalankan setelah 06 dan 11 (butuh car_b_id dan marketing_slug/marketing_email/marketing_password). Mengekspor transaction_b_id.",
  "prasyarat_data": [
    "Server lokal berjalan di http://localhost:8000.",
    "Skenario 06 dan 11 sudah dijalankan pada sesi browser yang sama.",
    "PENTING - langkah manual di tengah skenario ini: begitu panel log menampilkan 'Variabel {{transaction_b_id}} = <angka>', jalankan di terminal server: php scripts/pay_transaction_for_tester.php <angka>."
  ],
  "variabel": {
    "email_buyer": "{{buyer_email}}",
    "password_buyer": "{{buyer_password}}",
    "email_seller": "{{seller_email}}",
    "password_seller": "{{seller_password}}"
  },
  "urutan_uji": [
    {
      "urutan": 1,
      "halaman": "#/auth?role=buyer",
      "id": "hr_auth_role_buyer_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "Pilih role buyer",
      "tunggu": { "elemen": "#hr_auth_login_buyer_email_input", "timeout_ms": 15000 }
    },
    {
      "urutan": 2,
      "id": "hr_auth_login_buyer_email_input",
      "jenis": "input-email",
      "aksi": "isi",
      "nilai": "{{email_buyer}}",
      "nama": "Email buyer"
    },
    {
      "urutan": 3,
      "id": "hr_auth_login_buyer_password_input",
      "jenis": "input-password",
      "aksi": "isi",
      "nilai": "{{password_buyer}}",
      "nama": "Password buyer"
    },
    {
      "urutan": 4,
      "id": "hr_auth_login_buyer_submit_button",
      "jenis": "button-submit",
      "aksi": "klik",
      "nama": "Masuk sebagai buyer",
      "tunggu": { "route": "#/buyer", "timeout_ms": 20000 }
    },
    {
      "urutan": 5,
      "halaman": "#/af/{{marketing_slug}}",
      "aksi": "assert",
      "nama": "F3.4 - Kunjungan lewat link Marketing tercatat (route aktif)",
      "harapan": { "route_sama": "#/af/{{marketing_slug}}" },
      "timeout_ms": 15000
    },
    {
      "urutan": 6,
      "halaman": "#/af/{{marketing_slug}}/transactions/new?car_id={{car_b_id}}",
      "id": "pubtrx_booking_fee_value",
      "jenis": "container",
      "aksi": "verifikasi",
      "nama": "Booking Fee car_b tampil lewat konteks Marketing",
      "timeout_ms": 15000,
      "harapan": { "teks_tidak_mengandung": "Belum ditentukan showroom" }
    },
    {
      "urutan": 7,
      "id": "pubtrx_payment_method_bca_va_input",
      "jenis": "radio",
      "aksi": "klik",
      "nama": "Pilih metode pembayaran BCA VA"
    },
    {
      "urutan": 8,
      "id": "pubtrx_submit_button",
      "jenis": "button-submit",
      "aksi": "klik",
      "nama": "Buat transaksi kedua (car_b, lewat Marketing)",
      "tunggu": { "elemen": "#pubtrx_result_panel", "timeout_ms": 15000 }
    },
    {
      "urutan": 9,
      "id": "pubtrx_result_panel",
      "jenis": "container",
      "aksi": "verifikasi",
      "nama": "Tangkap transaction_b_id",
      "simpan": { "nama": "transaction_b_id", "dari": "atribut", "atribut": "data-transaction-id" }
    },
    {
      "urutan": 10,
      "id": "pubtrx_result_open_status_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "Buka status pembayaran transaction_b",
      "tunggu": { "route": "#/buyer/transactions/{{transaction_b_id}}", "timeout_ms": 10000 }
    },
    {
      "urutan": 11,
      "aksi": "assert",
      "nama": "MANUAL: jalankan jembatan pembayaran untuk transaction_b lalu tunggu Booking Fee Lunas",
      "catatan": "Jalankan sekarang: php scripts/pay_transaction_for_tester.php {{transaction_b_id}}",
      "tunggu": { "teks": "Pembayaran Berhasil", "timeout_ms": 90000 }
    },

    {
      "urutan": 20,
      "halaman": "#/profile",
      "id": "byr_profile_role_specific_logout_button",
      "jenis": "button",
      "aksi": "klik_opsional",
      "nama": "Buka konfirmasi logout buyer",
      "tunggu": { "elemen": "#profile_logout_confirm_button", "timeout_ms": 8000 }
    },
    {
      "urutan": 21,
      "id": "profile_logout_confirm_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "Konfirmasi logout buyer",
      "tunggu": { "ms": 1500 }
    },
    {
      "urutan": 22,
      "halaman": "#/auth?role=affiliate_admin",
      "id": "hr_auth_role_affiliate_admin_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "Pilih role Marketing",
      "tunggu": { "elemen": "#hr_auth_login_affiliate_admin_email_input", "timeout_ms": 15000 }
    },
    {
      "urutan": 23,
      "id": "hr_auth_login_affiliate_admin_email_input",
      "jenis": "input-email",
      "aksi": "isi",
      "nilai": "{{marketing_email}}",
      "nama": "Email Marketing"
    },
    {
      "urutan": 24,
      "id": "hr_auth_login_affiliate_admin_password_input",
      "jenis": "input-password",
      "aksi": "isi",
      "nilai": "{{marketing_password}}",
      "nama": "Password Marketing"
    },
    {
      "urutan": 25,
      "id": "hr_auth_login_affiliate_admin_submit_button",
      "jenis": "button-submit",
      "aksi": "klik",
      "nama": "F3.1 - Masuk sebagai Marketing",
      "tunggu": { "route": "#/affiliate", "timeout_ms": 20000 }
    },
    {
      "urutan": 26,
      "halaman": "#/affiliate/ledger",
      "selector": "#aff_ledger_{{transaction_b_id}}_section[data-ledger-status='accrued']",
      "jenis": "container",
      "aksi": "verifikasi",
      "nama": "Ledger transaction_b berstatus accrued",
      "timeout_ms": 15000,
      "harapan": { "elemen_ada": "#aff_ledger_{{transaction_b_id}}_section[data-ledger-status='accrued']" }
    },
    {
      "urutan": 27,
      "id": "aff_ledger_dashboard_button",
      "jenis": "button",
      "aksi": "klik_opsional",
      "nama": "Kembali ke dashboard Marketing"
    },

    {
      "urutan": 30,
      "halaman": "#/profile",
      "id": "profile_role_specific_logout_button",
      "jenis": "button",
      "aksi": "klik_opsional",
      "nama": "Buka konfirmasi logout Marketing",
      "tunggu": { "elemen": "#profile_logout_confirm_button", "timeout_ms": 8000 }
    },
    {
      "urutan": 31,
      "id": "profile_logout_confirm_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "Konfirmasi logout Marketing",
      "tunggu": { "ms": 1500 }
    },
    {
      "urutan": 32,
      "halaman": "#/auth?role=seller",
      "id": "hr_auth_role_seller_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "Pilih role seller",
      "tunggu": { "elemen": "#hr_auth_login_seller_email_input", "timeout_ms": 15000 }
    },
    {
      "urutan": 33,
      "id": "hr_auth_login_seller_email_input",
      "jenis": "input-email",
      "aksi": "isi",
      "nilai": "{{email_seller}}",
      "nama": "Email seller"
    },
    {
      "urutan": 34,
      "id": "hr_auth_login_seller_password_input",
      "jenis": "input-password",
      "aksi": "isi",
      "nilai": "{{password_seller}}",
      "nama": "Password seller"
    },
    {
      "urutan": 35,
      "id": "hr_auth_login_seller_submit_button",
      "jenis": "button-submit",
      "aksi": "klik",
      "nama": "Masuk sebagai seller",
      "tunggu": { "route": "#/seller", "timeout_ms": 15000 }
    },
    {
      "urutan": 36,
      "halaman": "#/seller/transactions/{{transaction_b_id}}",
      "id": "slrtx_return_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "E3.1 - Klik Retur",
      "dialog_jawaban": [
        "Alasan retur uji otomatis dari tester",
        true
      ],
      "tunggu": { "teks": "Diretur", "timeout_ms": 10000 }
    },
    {
      "urutan": 37,
      "aksi": "assert",
      "nama": "E3.x - Transaksi berstatus Diretur",
      "harapan": { "teks_mengandung": "Diretur", "lingkup": "halaman" }
    },
    {
      "urutan": 38,
      "halaman": "#/seller/cars",
      "selector": "#slrc_car_status_{{car_b_id}}_section",
      "jenis": "container",
      "aksi": "verifikasi",
      "nama": "car_b kembali berstatus Published",
      "timeout_ms": 15000,
      "harapan": { "teks_mengandung": "Tersedia" }
    },

    {
      "urutan": 40,
      "halaman": "#/profile",
      "id": "profile_role_specific_logout_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "Buka konfirmasi logout seller",
      "tunggu": { "elemen": "#profile_logout_confirm_button", "timeout_ms": 8000 }
    },
    {
      "urutan": 41,
      "id": "profile_logout_confirm_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "Konfirmasi logout seller",
      "tunggu": { "ms": 1500 }
    },
    {
      "urutan": 42,
      "halaman": "#/auth?role=affiliate_admin",
      "id": "hr_auth_role_affiliate_admin_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "Pilih role Marketing lagi",
      "tunggu": { "elemen": "#hr_auth_login_affiliate_admin_email_input", "timeout_ms": 15000 }
    },
    {
      "urutan": 43,
      "id": "hr_auth_login_affiliate_admin_email_input",
      "jenis": "input-email",
      "aksi": "isi",
      "nilai": "{{marketing_email}}",
      "nama": "Email Marketing"
    },
    {
      "urutan": 44,
      "id": "hr_auth_login_affiliate_admin_password_input",
      "jenis": "input-password",
      "aksi": "isi",
      "nilai": "{{marketing_password}}",
      "nama": "Password Marketing"
    },
    {
      "urutan": 45,
      "id": "hr_auth_login_affiliate_admin_submit_button",
      "jenis": "button-submit",
      "aksi": "klik",
      "nama": "Masuk lagi sebagai Marketing",
      "tunggu": { "route": "#/affiliate", "timeout_ms": 20000 }
    },
    {
      "urutan": 46,
      "halaman": "#/affiliate/ledger",
      "selector": "#aff_ledger_{{transaction_b_id}}_section[data-ledger-status='voided']",
      "jenis": "container",
      "aksi": "verifikasi",
      "nama": "E3.x - Ledger transaction_b berstatus voided setelah retur",
      "timeout_ms": 15000,
      "harapan": { "elemen_ada": "#aff_ledger_{{transaction_b_id}}_section[data-ledger-status='voided']" }
    }
  ]
}
