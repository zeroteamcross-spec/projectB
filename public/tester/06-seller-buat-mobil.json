      "tunggu": { "elemen": "#slrinsp_items_section", "timeout_ms": 8000 }
    },
    {
      "urutan": 42,
      "id": "slrinsp_items_section",
      "jenis": "container",
      "aksi": "verifikasi",
      "nama": "[car_a] C4 - Checklist master inspection tampil",
      "harapan": { "elemen_ada": "#slrinsp_items_section" }
    },
    {
      "urutan": 43,
      "selector": "[id^='slrinsp_condition_']",
      "indeks": 0,
      "jenis": "button",
      "aksi": "klik",
      "nama": "[car_a] Isi kondisi item inspeksi pertama",
      "catatan": "Demonstrasi nyata pengisian satu item checklist. Booking Fee, bukan status inspeksi, yang menentukan mobil bisa ditransaksikan, jadi checklist tidak perlu tuntas 100% untuk fixture ini."
    },
    {
