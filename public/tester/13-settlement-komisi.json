{
  "nama_fitur": "13 - Settlement komisi lalu retur ditolak karena sudah paid_out",
  "aplikasi": "projectB",
  "halaman": [
    "#/af/{{marketing_slug}}"
  ],
  "prefix_id": [
    "hr_auth_",
    "pubtrx_",
    "adfc_",
    "adst_",
    "slrtx_",
    "aff_",
    "profile_"
  ],
  "versi": "1.0",
  "warisi_variabel": true,
  "berhenti_saat_gagal": true,
  "keterangan": "Alur G + jalur negatif E3. car_b (published lagi setelah retur di skenario 12) dibeli ketiga kalinya lewat link Marketing yang sama, dibayar, lalu admin membuat settlement batch dan menandainya settled. Setelah itu showroom mencoba retur transaksi ketiga dan HARUS ditolak karena komisinya sudah paid_out. Ditutup dengan memastikan riwayat settlement tampil di dashboard Marketing. Jalankan setelah 06, 11, 12. Mengekspor transaction_c_id dan settlement_id.",
  "prasyarat_data": [
    "Server lokal berjalan di http://localhost:8000.",
    "Skenario 06, 11, dan 12 sudah dijalankan pada sesi browser yang sama.",
    "Kredensial admin diambil dari tester/akun.json (admin_email/admin_password).",
    "PENTING - langkah manual di tengah skenario ini: begitu panel log menampilkan 'Variabel {{transaction_c_id}} = <angka>', jalankan di terminal server: php scripts/pay_transaction_for_tester.php <angka>."
  ],
  "variabel": {
    "email_buyer": "{{buyer_email}}",
    "password_buyer": "{{buyer_password}}",
    "email_seller": "{{seller_email}}",
    "password_seller": "{{seller_password}}",
    "email_admin": "{{admin_email}}",
    "password_admin": "{{admin_password}}"
  },
  "urutan_uji": [
    {
      "urutan": 1,
      "halaman": "#/auth?role=buyer",
      "id": "hr_auth_role_buyer_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "Pilih role buyer",
      "tunggu": { "elemen": "#hr_auth_login_buyer_email_input", "timeout_ms": 15000 }
    },
    {
      "urutan": 2,
      "id": "hr_auth_login_buyer_email_input",
      "jenis": "input-email",
      "aksi": "isi",
      "nilai": "{{email_buyer}}",
      "nama": "Email buyer"
    },
    {
      "urutan": 3,
      "id": "hr_auth_login_buyer_password_input",
      "jenis": "input-password",
      "aksi": "isi",
      "nilai": "{{password_buyer}}",
      "nama": "Password buyer"
    },
    {
      "urutan": 4,
      "id": "hr_auth_login_buyer_submit_button",
      "jenis": "button-submit",
      "aksi": "klik",
      "nama": "Masuk sebagai buyer",
      "tunggu": { "route": "#/buyer", "timeout_ms": 20000 }
    },
    {
      "urutan": 5,
      "halaman": "#/af/{{marketing_slug}}/transactions/new?car_id={{car_b_id}}",
      "id": "pubtrx_booking_fee_value",
      "jenis": "container",
      "aksi": "verifikasi",
      "nama": "car_b tersedia lagi untuk dibeli ketiga kalinya",
      "timeout_ms": 15000,
      "harapan": { "teks_tidak_mengandung": "Belum ditentukan showroom" }
    },
    {
      "urutan": 6,
      "id": "pubtrx_payment_method_bca_va_input",
      "jenis": "radio",
      "aksi": "klik",
      "nama": "Pilih metode pembayaran BCA VA"
    },
    {
      "urutan": 7,
      "id": "pubtrx_submit_button",
      "jenis": "button-submit",
      "aksi": "klik",
      "nama": "Buat transaksi ketiga (car_b)",
      "tunggu": { "elemen": "#pubtrx_result_panel", "timeout_ms": 15000 }
    },
    {
      "urutan": 8,
      "id": "pubtrx_result_panel",
      "jenis": "container",
      "aksi": "verifikasi",
      "nama": "Tangkap transaction_c_id",
      "simpan": { "nama": "transaction_c_id", "dari": "atribut", "atribut": "data-transaction-id" }
    },
    {
      "urutan": 9,
      "id": "pubtrx_result_open_status_button",
      "jenis": "button",
      "aksi": "klik",
      "nama": "Buka status pembayaran transaction_c",
      "tunggu": { "route": "#/buyer/transactions/{{transaction_c_id}}", "timeout_ms": 10000 }
    },
    {
      "urutan": 10,
      "aksi": "assert",
      "nama": "MANUAL: jalankan jembatan pembayaran untuk transaction_c lalu tunggu Booking Fee Lunas",
      "catatan": "Jalankan sekarang: php scripts/pay_transaction_for_tester.php {{transaction_c_id}}",
      "tunggu": { "teks": "Pembayaran Berhasil", "timeout_ms": 90000 }
    },

    {
