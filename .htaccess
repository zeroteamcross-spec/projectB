DirectoryIndex index.php index.html app.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep real files/folders in public_html accessible if they exist.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send everything else to the bridge index.php.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

Options -Indexes
