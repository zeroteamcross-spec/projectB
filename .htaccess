DirectoryIndex index.php index.html app.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan ganggu file/folder yang memang ada di public_html.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Semua request lain masuk ke bridge public_html/index.php.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

Options -Indexes
